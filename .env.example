# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/VisionLearn

# ── Mistral API ───────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_TEXT_MODEL=mistral-small-latest     # for timestamp selection
MISTRAL_VISION_MODEL=pixtral-12b-2409      # MUST be pixtral for image processing
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest  # for audio transcription

# ── Pipeline configuration ────────────────────────────────────────────────────
STORAGE_PATH=./storage           # where all pipeline artifacts are saved
AUDIO_CHUNK_COUNT=12             # number of parallel transcription chunks
MAX_FRAME_WORKERS=8              # max parallel ffmpeg frame extraction processes
WHISPER_LANGUAGE=en              # hint Voxtral to the audio language

# ── Text-to-Speech ────────────────────────────────────────────────────────────
EDGE_TTS_VOICE=en-US-GuyNeural  # edge-tts voice for narration

# ── FastAPI ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
